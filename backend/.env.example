# CropKart Backend Environment Variables Template

# Supabase PostgreSQL Storage Configuration
# Option A: Supabase Direct / Pooled PostgreSQL connection URL
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Option B: Supabase REST API credentials


# Agricultural Market Data Source (CEDA Agmarknet API & Fallback)
CEDA_API_TOKEN=your-ceda-api-token-here
DATA_SOURCE_URL=https://raw.githubusercontent.com/iancovert/Agmarknet/master/Wheat/2017.csv
DATA_GOV_IN_API_KEY=your-optional-data-gov-in-api-key

# LangFlow AI Service
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=YOUR_FLOW_ID
LANGFLOW_API_KEY=YOUR_API_KEY
LANGFLOW_TIMEOUT=120.0
