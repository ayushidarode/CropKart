# Database Configuration
POSTGRES_USER=cropkart
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=cropkart
# For local development on host:
# DATABASE_URL=postgresql+psycopg://cropkart:YOUR_POSTGRES_PASSWORD@localhost:5432/cropkart
# For Docker Compose:
DATABASE_URL=postgresql+psycopg://cropkart:YOUR_POSTGRES_PASSWORD@postgres:5432/cropkart

# LangFlow AI Agent Configuration
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=YOUR_FLOW_ID
LANGFLOW_API_KEY=YOUR_API_KEY
LANGFLOW_TIMEOUT=30.0

# Supabase PostgreSQL Storage Configuration
# Option A: Supabase Direct / Pooled PostgreSQL connection URL
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Option B: Supabase REST API credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Agricultural Data Collection Source Configuration
DATA_SOURCE_URL=https://raw.githubusercontent.com/iancovert/Agmarknet/master/Wheat/2017.csv
DATA_GOV_IN_API_KEY=your-optional-data-gov-in-api-key

